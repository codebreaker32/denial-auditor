# Copy to .env and fill in. .env is gitignored.
# Get a key at https://app.tavily.com
TAVILY_API_KEY=tvly-...

# Nebius Token Factory key: https://tokenfactory.nebius.com
NEBIUS_TOKEN_FACTORY_KEY=...
# Hard cap on total Token Factory spend, enforced in code (budget.py)
TOKEN_FACTORY_BUDGET_USD=27
# Hard cap on total Tavily credits, enforced in code (budget.py)
TAVILY_CREDIT_CAP=4125
