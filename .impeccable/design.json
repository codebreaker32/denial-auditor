 "components": [
  {
   "name": "Primary Button",
   "kind": "button",
   "refersTo": "button-primary",
   "description": "Black pill, one per screen: Export letter, Review appeal, Run.",
   "html": "<button class=\"ds-btn-primary\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4v11M7 10l5 5 5-5M5 20h14\"/></svg>Export letter</button>",
   "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;min-height:36px;padding:9px 18px;border:0;border-radius:999px;background:#121212;color:#FFFFFF;font-family:var(--font, Switzer, system-ui, sans-serif);font-weight:500;font-size:14px;line-height:20px;cursor:pointer;transition:background-color 150ms cubic-bezier(.16,1,.3,1)}.ds-btn-primary svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-btn-primary:hover{background:#000000}.ds-btn-primary:active{background:#333333}.ds-btn-primary:focus-visible{outline:2px solid #1E4BD7;outline-offset:2px}"
  },
  {
   "name": "Secondary Button",
   "kind": "button",
   "refersTo": "button-secondary",
   "description": "Grey pill for secondary actions (Edit text).",
   "html": "<button class=\"ds-btn-secondary\">Edit text</button>",
   "css": ".ds-btn-secondary{display:inline-flex;align-items:center;min-height:36px;padding:9px 18px;border:0;border-radius:999px;background:#EDEDEC;color:#121212;font-family:var(--font, Switzer, system-ui, sans-serif);font-weight:500;font-size:14px;line-height:20px;cursor:pointer;transition:background-color 150ms cubic-bezier(.16,1,.3,1)}.ds-btn-secondary:hover{background:#E8E8E6}.ds-btn-secondary:focus-visible{outline:2px solid #1E4BD7;outline-offset:2px}"
  },
  {
   "name": "Locked Export",
   "kind": "button",
   "refersTo": "button-disabled",
   "description": "Export stays locked, with the reason beside it, until every quote verifies.",
   "html": "<div class=\"ds-lock\"><button class=\"ds-btn-locked\" aria-disabled=\"true\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"9\" rx=\"2\"/><path d=\"M8 11V8a4 4 0 0 1 8 0v3\"/></svg>Export locked</button><p>Fix or remove the quote marked “Not in source”, then export opens.</p></div>",
   "css": ".ds-lock{display:grid;gap:8px;justify-items:start;font-family:var(--font, Switzer, system-ui, sans-serif);}.ds-btn-locked{display:inline-flex;align-items:center;gap:8px;min-height:36px;padding:9px 18px;border:0;border-radius:999px;background:#EDEDEC;color:#666666;font:inherit;font-weight:500;font-size:14px;cursor:not-allowed}.ds-btn-locked svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8}.ds-lock p{margin:0;font-size:14px;line-height:20px;color:#121212}"
  },
  {
   "name": "Pill Input",
   "kind": "input",
   "refersTo": "input",
   "description": "40px pill field with a sentence-case label above.",
   "html": "<label class=\"ds-field\"><span>Passcode</span><input class=\"ds-input\" placeholder=\"Enter the demo passcode\"></label>",
   "css": ".ds-field{display:grid;gap:8px;font-family:var(--font, Switzer, system-ui, sans-serif);font-size:14px}.ds-field span{font-weight:500}.ds-input{height:40px;padding:0 16px;border:1px solid #D6D6D3;border-radius:999px;background:#FFFFFF;color:#121212;font:inherit}.ds-input::placeholder{color:#666666}.ds-input:focus-visible{outline:2px solid #1E4BD7;outline-offset:1px;border-color:#1E4BD7}"
  },
  {
   "name": "Navigation",
   "kind": "nav",
   "refersTo": "nav-item-current",
   "description": "Frame sidebar; the current item is a white pill that reads as part of the sheet.",
   "html": "<nav class=\"ds-nav\"><a aria-current=\"page\">Worklist<span>7</span></a><a>Prior-auth checks</a><a>Run live</a></nav>",
   "css": ".ds-nav{display:grid;gap:2px;width:220px;padding:12px;background:#EDEDEC;font-family:var(--font, Switzer, system-ui, sans-serif);}.ds-nav a{display:flex;align-items:center;height:36px;padding:0 12px;border-radius:999px;color:#4D4D4D;font-weight:500;font-size:14px;cursor:pointer;transition:background-color 150ms}.ds-nav a:hover{background:#E8E8E6;color:#121212}.ds-nav a[aria-current]{background:#FFFFFF;color:#121212}.ds-nav span{margin-left:auto;min-width:22px;height:20px;padding:0 6px;border-radius:999px;background:#F5F5F4;font-size:12px;display:inline-grid;place-items:center}"
  },
  {
   "name": "Status Marks",
   "kind": "chip",
   "refersTo": "mark-positive",
   "description": "Hue + glyph + word, always; blue only for verified.",
   "html": "<div class=\"ds-marks\"><span class=\"ds-mark pos\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>Appeal</span><span class=\"ds-mark warn\"><svg viewBox=\"0 0 24 24\"><path d=\"M10 6v12M14 6v12\"/></svg>Missing docs</span><span class=\"ds-mark neg\"><svg viewBox=\"0 0 24 24\"><path d=\"M10 6v12M14 6v12\"/></svg>Don't appeal yet</span><span class=\"ds-mark ver\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"#1E4BD7\" stroke=\"none\"/><path d=\"M7.6 12.4l3 3 5.8-6.2\" stroke=\"#FFFFFF\"/></svg>22 of 22 match their source</span></div>",
